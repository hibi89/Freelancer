{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:3b",
  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env*",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "ollama",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "webfetch:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "websearch:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "external_directory:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:*",
      "effect": "deny"
    }
  ]
}
